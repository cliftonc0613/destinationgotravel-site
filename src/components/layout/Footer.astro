---
const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Dawn' },
  { href: '/destinations', label: 'Destinations' },
  { href: '/plan-my-trip', label: 'Plan My Trip' },
  { href: '/blog', label: 'Blog' },
];

const resourceLinks = [
  { href: '/travel-insurance', label: 'Travel Insurance' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms & Conditions' },
];

const locations = ['Greenville, SC', 'Spartanburg, SC', 'Anderson, SC', 'Clemson, SC'];
---

<footer>
  <!-- Newsletter bar -->
  <div class="footer-newsletter">
    <div class="container">
      <div class="footer-newsletter-inner">
        <div>
          <p>Get travel inspiration delivered to your inbox.</p>
          <p>Destinations, deals, and trip ideas from Dawn — no spam, ever.</p>
        </div>
        <form class="footer-form" name="newsletter" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="newsletter" />
          <input class="footer-input" type="email" name="email" placeholder="Your email address" required aria-label="Email address" />
          <button class="footer-subscribe" type="submit">Subscribe</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="container">
    <div class="footer-main">
      <!-- Brand col -->
      <div>
        <a href="/" class="footer-logo" aria-label="DestinationGo Travel — Home">
          <img src="/images/dgota-logo.png" alt="DestinationGo Travel" width="140" height="60" />
        </a>
        <p class="footer-tagline">Luxury travel planning for Europe, all-inclusives, and cruises. Based in Upstate South Carolina.</p>
        <div class="footer-social">
          <a href="https://facebook.com/profile.php?id=100095178252273" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Facebook">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://instagram.com/destinationgotravelagency" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Instagram">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <p class="footer-col-title">Quick Links</p>
        <ul class="footer-links">
          {quickLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Resources + Locations -->
      <div>
        <p class="footer-col-title">Resources</p>
        <ul class="footer-links">
          {resourceLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
        <p class="footer-col-title" style="margin-top:2rem;">Service Areas</p>
        <ul class="footer-links">
          {locations.map(loc => (
            <li><span>{loc}</span></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="footer-col-title">Connect</p>
        <a href="tel:8645060213" class="footer-contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.82 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          864-506-0213
        </a>
        <a href="mailto:dawn@destinationgotravel.com" class="footer-contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          dawn@destinationgotravel.com
        </a>
      </div>
    </div>

    <div class="footer-copyright">
      &copy; {new Date().getFullYear()} Dawn Owens Travel. All rights reserved.
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--teal-800);
    color: var(--cream-100);
  }

  .footer-newsletter {
    border-bottom: 1px solid rgba(14, 63, 69, 0.6);
    background-color: rgba(6, 43, 48, 0.4);
    padding: 2.5rem 0;
  }
  .footer-newsletter-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .footer-newsletter p:first-child {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--cream-50);
  }
  .footer-newsletter p:last-child {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--teal-300);
    margin-top: 0.25rem;
  }
  .footer-form {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
    width: 100%;
  }
  .footer-input {
    flex: 1;
    padding: 0.625rem 1rem;
    border: 1px solid var(--teal-600);
    border-radius: 6px;
    background-color: rgba(14, 81, 89, 0.5);
    color: var(--cream-50);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 150ms ease;
  }
  .footer-input::placeholder { color: var(--teal-300); }
  .footer-input:focus { border-color: var(--gold-500); }
  .footer-subscribe {
    background-color: var(--gold-500);
    color: var(--ink-900);
    padding: 0.625rem 1.25rem;
    border: none;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 150ms ease;
  }
  .footer-subscribe:hover { background-color: var(--gold-400); }

  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding: 3rem 0;
  }
  .footer-logo img { height: auto; width: 70%; object-fit: contain; }
  .footer-tagline {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--teal-300);
    margin-top: 1rem;
  }
  .footer-col-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gold-500);
    margin-bottom: 1rem;
  }
  .footer-links {
    list-style: none;
  }
  .footer-links li { margin-bottom: 0.625rem; }
  .footer-links a,
  .footer-links span {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--gold-400);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .footer-links a:hover { color: var(--gold-500); }
  .footer-links span { color: var(--teal-300); }

  .footer-contact-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--gold-400);
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: color 150ms ease;
  }
  .footer-contact-link:hover { color: var(--gold-500); }

  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .footer-social-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--teal-600);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold-400);
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .footer-social-btn:hover { border-color: var(--gold-500); color: var(--gold-500); }

  .footer-copyright {
    border-top: 1px solid rgba(14, 63, 69, 0.6);
    padding: 2rem 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--teal-300);
  }

  @media (max-width: 900px) {
    .footer-main { grid-template-columns: 1fr 1fr; }
    .footer-newsletter-inner { flex-direction: column; }
  }
  @media (max-width: 600px) {
    .footer-main { grid-template-columns: 1fr; }
  }
</style>
