---
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/destinations', label: 'Destinations' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/blog', label: 'Blog' },
];
---

<header id="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="DestinationGo Travel — Home">
        <img src="/images/dgota-logo-horiz.png" alt="DestinationGo Travel" width="180" height="48" />
      </a>

      <nav aria-label="Main navigation">
        {navLinks.map(link => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </nav>

      <a href="/plan-my-trip" class="btn btn--primary-teal">Plan My Trip</a>

      <button class="mobile-menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="19" y2="6" />
          <line x1="3" y1="11" x2="19" y2="11" />
          <line x1="3" y1="16" x2="19" y2="16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu outside <header> so backdrop-filter doesn't create a new containing block -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <button class="mobile-menu-close" aria-label="Close navigation menu">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="4" y1="4" x2="18" y2="18" />
      <line x1="18" y1="4" x2="4" y2="18" />
    </svg>
  </button>
  <nav aria-label="Mobile navigation">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav-link">{link.label}</a>
    ))}
    <a href="/plan-my-trip" class="btn btn--primary-teal mobile-cta">Plan My Trip</a>
    <div class="mobile-social">
      <a href="https://www.facebook.com/profile.php?id=100095178252273" target="_blank" rel="noopener noreferrer" class="mobile-social-btn" aria-label="Facebook">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href="https://www.instagram.com/destinationgotravelagency" target="_blank" rel="noopener noreferrer" class="mobile-social-btn" aria-label="Instagram">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
      </a>
    </div>
  </nav>
</div>
<div class="mobile-overlay" id="mobile-overlay"></div>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: rgba(251, 250, 245, 0.95);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: box-shadow 250ms ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
    transition: height 250ms ease;
  }

  .logo img {
    height: 3rem;
    width: auto;
    object-fit: contain;
    transition: height 250ms ease;
  }

  /* Scrolled state */
  header.is-scrolled .header-inner {
    height: 3.25rem;
  }
  header.is-scrolled .logo img {
    height: 2.125rem;
  }
  header.is-scrolled {
    box-shadow: 0 2px 16px rgba(6, 43, 48, 0.08);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.70rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-700);
    text-decoration: none;
    position: relative;
    transition: color 180ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--gold-500);
    transition: width 180ms ease;
  }
  .nav-link:hover { color: var(--teal-700); }
  .nav-link:hover::after { width: 100%; }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-700);
    padding: 4px;
  }

  /* Mobile menu panel */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background-color: #ffffff;
    border-left: 1px solid var(--line);
    padding: 2rem 1.5rem;
    z-index: 100;
    transform: translateX(100%);
    transition: transform 300ms var(--ease-resort);
    flex-direction: column;
  }
  .mobile-menu.is-open {
    transform: translateX(0);
  }
  .mobile-menu-close {
    align-self: flex-end;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink-700);
    padding: 4px;
    margin-bottom: 2rem;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }
  .mobile-nav-link {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-700);
    text-decoration: none;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    width: 100%;
    display: block;
    transition: color 150ms ease;
  }
  .mobile-nav-link:hover { color: var(--teal-700); }
  .mobile-cta {
    margin-top: 2rem;
    width: 100%;
    text-align: center;
  }

  .mobile-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .mobile-social-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .mobile-social-btn:hover { border-color: var(--teal-700); color: var(--teal-700); }

  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(6, 43, 48, 0.5);
    z-index: 99;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .mobile-overlay.is-open { opacity: 1; pointer-events: auto; }

  @media (max-width: 768px) {
    nav, header > .container > .header-inner > .btn { display: none; }
    .mobile-menu-toggle { display: flex; }
    .mobile-menu { display: flex; }
    .mobile-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .mobile-social-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .mobile-social-btn:hover { border-color: var(--teal-700); color: var(--teal-700); }

  .mobile-overlay { display: block; }
  }
</style>

<script>
  const header = document.getElementById('site-header') as HTMLElement;

  function onScroll() {
    header.classList.toggle('is-scrolled', window.scrollY >= 200);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.querySelector('.mobile-menu-toggle') as HTMLButtonElement;
  const close = document.querySelector('.mobile-menu-close') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const overlay = document.getElementById('mobile-overlay') as HTMLElement;

  function openMenu() {
    menu.classList.add('is-open');
    overlay.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    menu.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu.classList.remove('is-open');
    overlay.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
