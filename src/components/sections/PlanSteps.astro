---
const steps = [
  {
    numeral: 'I',
    title: "Tell Dawn what you're dreaming of",
    desc: "Fill out a short inquiry form and describe the trip you have in mind. No commitment, no pressure — just a conversation starter.",
  },
  {
    numeral: 'II',
    title: 'She builds your trip around you',
    desc: "Dawn reviews your inquiry and reaches out to schedule a call. Together you'll define the destination, dates, style, and budget.",
  },
  {
    numeral: 'III',
    title: 'Show up and enjoy it',
    desc: "You'll receive a detailed itinerary before departure. All that's left is to pack your bag.",
  },
];
---

<section class="plan-steps" id="how-it-works">
  <div class="container">

    <div class="steps-header">
      <p class="eyebrow eyebrow--gold">The Process</p>
      <div class="hairline" style="margin-inline:auto;"></div>
      <h2 class="steps-heading">Three steps to your best trip yet.</h2>
    </div>

    <div class="steps-row">
      {steps.map((step, i) => (
        <div class={`step${i > 0 ? ' step--bordered' : ''}`}>
          <div class="step-rule" aria-hidden="true"></div>
          <div class="step-numeral" aria-hidden="true">{step.numeral}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="steps-cta">
      <a href="/plan-my-trip" class="btn btn--outline-gold">Begin with Step One &rarr;</a>
    </div>

  </div>
</section>

<style>
  .plan-steps {
    background-color: var(--teal-900);
    padding: 5.5rem 0;
  }

  .steps-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .steps-heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.75rem);
    color: var(--cream-50);
    margin-top: 0.25rem;
    line-height: 1.2;
  }

  /* Three columns */
  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 980px;
    margin-inline: auto;
  }

  .step {
    padding: 0 2.5rem 0 0;
  }

  /* Vertical gold rule between columns */
  .step--bordered {
    padding-left: 2.5rem;
    border-left: 1px solid rgba(230, 206, 146, 0.2);
  }

  /* Short gold rule above numeral */
  .step-rule {
    width: 2rem;
    height: 1px;
    background-color: var(--gold-500);
    margin-bottom: 1.5rem;
    opacity: 0.6;
  }

  /* Large decorative roman numeral */
  .step-numeral {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 4vw, 4.5rem);
    color: var(--gold-400);
    opacity: 0.25;
    line-height: 1;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
    user-select: none;
  }

  .step-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--cream-50);
    line-height: 1.35;
    margin-bottom: 1rem;
  }

  .step-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(251, 250, 245, 0.6);
  }

  .steps-cta {
    text-align: center;
    margin-top: 4rem;
  }

  @media (max-width: 700px) {
    .steps-row {
      grid-template-columns: 1fr;
    }
    .step {
      padding: 2rem 0 0;
      border-left: none;
      border-top: 1px solid rgba(230, 206, 146, 0.2);
    }
    .step--bordered {
      padding-left: 0;
      border-left: none;
    }
    .step:first-child {
      padding-top: 0;
      border-top: none;
    }
  }
</style>
