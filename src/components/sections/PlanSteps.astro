---
const steps = [
  {
    num: '1',
    title: "Tell Dawn what you're dreaming of",
    desc: "Fill out a short inquiry form and describe the trip you have in mind. No commitment, no pressure — just a conversation starter.",
    side: 'left',
  },
  {
    num: '2',
    title: 'She builds your trip around you',
    desc: "Dawn reviews your inquiry and reaches out to schedule a call. Together you'll define the destination, dates, style, and budget. She handles everything from there.",
    side: 'right',
  },
  {
    num: '3',
    title: 'Show up and enjoy it',
    desc: "You'll receive a detailed itinerary before departure so every moment is accounted for. All that's left is to pack your bag.",
    side: 'left',
  },
];
---

<section class="plan-steps" id="how-it-works">
  <div class="container">
    <div style="text-align:center; margin-bottom:4rem;">
      <p class="eyebrow">The Process</p>
      <div class="hairline"></div>
      <h2 class="section-heading">Three steps to your best trip yet.</h2>
      <p class="section-subheading">Getting started is simple — and commitment-free.</p>
    </div>
    <div class="steps-track">
      <div class="steps-line" aria-hidden="true"></div>
      {steps.map(step => (
        <div class={`step step--${step.side}`}>
          {step.side === 'left' ? (
            <>
              <div class="step-card card"><h3 class="step-title">{step.title}</h3><p class="step-desc">{step.desc}</p></div>
              <div class="step-circle">{step.num}</div>
              <div></div>
            </>
          ) : (
            <>
              <div></div>
              <div class="step-circle">{step.num}</div>
              <div class="step-card card"><h3 class="step-title">{step.title}</h3><p class="step-desc">{step.desc}</p></div>
            </>
          )}
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top:3.5rem;">
      <a href="/plan-my-trip" class="btn btn--primary-teal">Start with Step 1 →</a>
    </div>
  </div>
</section>

<style>
  .plan-steps {
    background-color: var(--cream-100);
    padding: 5rem 0;
  }
  .steps-track {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
  }
  .steps-line {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    width: 1px;
    background-color: var(--gold-500);
    opacity: 0.4;
    transform: translateX(-50%);
  }
  .step {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .step:last-child { margin-bottom: 0; }
  .step-card { padding: 2rem; }
  .step-circle {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: var(--teal-700);
    border: 2px solid var(--gold-500);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--cream-50);
    letter-spacing: 0.05em;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--ink-900);
    margin-bottom: 0.75rem;
  }
  .step-desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-700);
  }
  @media (max-width: 900px) {
    .steps-line { display: none; }
    .step {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .step-circle { margin-inline: auto; }
    .step > div:empty { display: none; }
  }
</style>
