---
const steps = [
  {
    numeral: 'I',
    title: "Tell Dawn what you're dreaming of",
    desc: "Fill out a short inquiry form and describe the trip you have in mind. No commitment, no pressure. Just a conversation starter.",
  },
  {
    numeral: 'II',
    title: 'She builds your trip around you',
    desc: "Dawn reviews your inquiry and reaches out to schedule a call. Together you'll define the destination, dates, style, and budget.",
  },
  {
    numeral: 'III',
    title: 'Show up and enjoy it',
    desc: "You'll receive a detailed itinerary before departure. All that's left is to pack your bag.",
  },
];
---

<section class="plan-steps" id="how-it-works">
  <div class="container">

    <div class="steps-header">
      <p class="eyebrow eyebrow--gold">The Process</p>
      <div class="hairline" style="margin-inline:auto;"></div>
      <h2 class="steps-heading">Three steps to your best trip yet.</h2>
    </div>

    <div class="steps-row">
      {steps.map((step, i) => (
        <div class={`step${i > 0 ? ' step--bordered' : ''}`}>
          <div class="step-rule" aria-hidden="true"></div>
          <div class="step-numeral" aria-hidden="true">{step.numeral}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="steps-cta">
      <a href="/plan-my-trip" class="btn btn--outline-gold steps-btn">Begin with Step One &rarr;</a>
    </div>

  </div>
</section>

<style>
  .plan-steps {
    background-color: var(--teal-900);
    padding: 7rem 0;
  }

  .steps-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .steps-heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 2.5vw + 0.75rem, 3rem);
    color: var(--cream-50);
    margin-top: 0.5rem;
    line-height: 1.2;
  }

  /* Three columns */
  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 1020px;
    margin-inline: auto;
  }

  .step {
    padding: 0 3rem 0 0;
    text-align: center;
    align-items: center;
    display: flex;
    flex-direction: column;
  }

  .step--bordered {
    padding-left: 3rem;
    border-left: 1px solid rgba(230, 206, 146, 0.18);
  }

  /* Gold rule opener — longer, more visible */
  .step-rule {
    width: 3rem;
    height: 1px;
    background-color: var(--gold-500);
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  /* Roman numeral — intentional, not a ghost */
  .step-numeral {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 5vw, 5.5rem);
    color: var(--gold-400);
    opacity: 0.35;
    line-height: 1;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
    user-select: none;
  }

  /* Italic to match the section heading voice */
  .step-title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-style: italic;
    font-size: 1.3125rem;
    color: var(--cream-50);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .step-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.8;
    color: rgba(251, 250, 245, 0.55);
  }

  .steps-cta {
    text-align: center;
    margin-top: 5rem;
  }

  /* Crisper border on dark bg */
  .steps-btn {
    border-color: rgba(230, 206, 146, 0.65);
  }
  .steps-btn:hover {
    border-color: var(--gold-500);
    color: var(--gold-500);
  }

  @media (max-width: 700px) {
    .plan-steps { padding: 5rem 0; }
    .steps-row { grid-template-columns: 1fr; }
    .step {
      padding: 2.5rem 0 0;
      border-top: 1px solid rgba(230, 206, 146, 0.18);
    }
    .step--bordered { padding-left: 0; border-left: none; }
    .step:first-child { padding-top: 0; border-top: none; }
  }
</style>
