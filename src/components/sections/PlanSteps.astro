---
const steps = [
  {
    num: '1',
    title: "Tell Dawn what you're dreaming of",
    desc: "Fill out a short inquiry form and describe the trip you have in mind. No commitment, no pressure — just a conversation starter.",
  },
  {
    num: '2',
    title: 'She builds your trip around you',
    desc: "Dawn reviews your inquiry and reaches out to schedule a call. Together you'll define the destination, dates, style, and budget.",
  },
  {
    num: '3',
    title: 'Show up and enjoy it',
    desc: "You'll receive a detailed itinerary before departure. All that's left is to pack your bag.",
  },
];
---

<section class="plan-steps" id="how-it-works">
  <div class="container">
    <div class="steps-header">
      <p class="eyebrow">The Process</p>
      <div class="hairline" style="margin-inline:auto;"></div>
      <h2 class="section-heading">Three steps to your best trip yet.</h2>
      <p class="section-subheading">Getting started is simple — and commitment-free.</p>
    </div>

    <div class="steps-row">
      <!-- connector line sits behind the circles -->
      <div class="steps-connector" aria-hidden="true"></div>

      {steps.map(step => (
        <div class="step">
          <div class="step-circle">{step.num}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="steps-cta">
      <a href="/plan-my-trip" class="btn btn--primary-teal">Start with Step 1 &rarr;</a>
    </div>
  </div>
</section>

<style>
  .plan-steps {
    background-color: var(--cream-100);
    padding: 5rem 0;
  }

  .steps-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  /* Row of 3 steps */
  .steps-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: 960px;
    margin-inline: auto;
  }

  /* Horizontal line through circle centers */
  .steps-connector {
    position: absolute;
    top: 2rem; /* half of circle height (4rem / 2) */
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 1px;
    background: var(--gold-500);
    opacity: 0.4;
    transform: translateY(-50%);
    z-index: 0;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .step-circle {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: var(--teal-700);
    border: 2px solid var(--gold-500);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--cream-50);
    letter-spacing: 0.05em;
    flex-shrink: 0;
    margin-bottom: 1.5rem;
  }

  .step-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--ink-900);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .step-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-600);
  }

  .steps-cta {
    text-align: center;
    margin-top: 3rem;
  }

  @media (max-width: 700px) {
    .steps-row {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .steps-connector { display: none; }
  }
</style>
