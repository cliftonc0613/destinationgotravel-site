---
const problems = [
  {
    title: 'Too many options, not enough clarity',
    desc: 'You deserve a travel experience that feels effortless, elevated, and fully taken care of.',
  },
  {
    title: 'The research never ends',
    desc: "Every time you think you've found it, a new review changes your mind. The tab count grows. The confidence shrinks.",
  },
  {
    title: "You've earned a trip that feels effortless",
    desc: "You deserve a travel experience that feels effortless, elevated, and fully taken care of.",
  },
];
---

<section class="problem-section">
  <div class="container">
    <div class="problem-header">
      <p class="eyebrow">The Challenge</p>
      <div class="hairline"></div>
      <h2 class="section-heading">Sound familiar?</h2>
      <p class="section-subheading">You've spent hours on Google, travel forums, and review sites. Every search opens ten more tabs. Every article contradicts the last one.</p>
    </div>
    <div class="problem-list">
      {problems.map((p, i) => (
        <>
          {i > 0 && <div class="problem-divider"></div>}
          <div class="problem-item">
            <h3 class="problem-title">{p.title}</h3>
            <p class="problem-desc">{p.desc}</p>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .problem-section {
    background-color: var(--cream-100);
    padding: 5rem 0;
  }
  .problem-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .problem-list { max-width: 700px; margin-inline: auto; }
  .problem-item { padding: 2.5rem 0; text-align: center; }
  .problem-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--ink-900);
    line-height: 1.3;
    margin-bottom: 1rem;
  }
  .problem-desc {
    font-family: var(--font-heading);
    font-weight: 400;
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--ink-700);
    max-width: 520px;
    margin-inline: auto;
  }
  .problem-divider {
    width: 70px;
    height: 1px;
    background-color: var(--gold-500);
    margin-inline: auto;
  }
</style>
