---
---
<section class="final-cta">
  <div class="final-filigree" aria-hidden="true"></div>
  <div class="container">
    <div class="final-cta-inner">
      <p class="eyebrow eyebrow--gold" style="margin-bottom:1.25rem;">Take the First Step</p>
      <div class="hairline"></div>
      <h2 class="section-heading section-heading--display section-heading--light" style="font-size:clamp(1.75rem, 3vw + 0.5rem, 3rem);">
        Ready to stop researching and start planning?
      </h2>
      <p class="section-subheading section-subheading--light" style="margin-top:1.25rem;">
        Tell Dawn where you want to go. She'll take it from there.
      </p>
      <div class="final-ctas">
        <a href="/plan-my-trip" class="btn btn--primary">Plan My Trip</a>
        <a href="/plan-my-trip" class="btn btn--outline-teal">Schedule a Call</a>
      </div>
      <div class="contact-row">
        <a href="tel:8645060213" class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.82 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          864-506-0213
        </a>
        <a href="mailto:dawn@destinationgotravel.com" class="contact-link">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          dawn@destinationgotravel.com
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    background-color: var(--teal-700);
    padding: 5rem 0;
  }
  .final-filigree {
    position: absolute;
    inset: 16px;
    border: 1px solid rgba(230, 206, 146, 0.15);
    pointer-events: none;
  }
  .final-cta-inner {
    position: relative;
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
  }
  .final-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .contact-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(230, 206, 146, 0.30);
    flex-wrap: wrap;
  }
  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--gold-400);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .contact-link:hover { color: var(--gold-500); }
  .contact-icon { width: 1rem; height: 1rem; }
  @media (max-width: 600px) {
    .final-ctas { flex-direction: column; align-items: center; }
  }
</style>
