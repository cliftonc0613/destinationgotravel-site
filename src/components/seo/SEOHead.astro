---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
  publishDate?: string;
  updatedDate?: string;
  schema?: object | object[];
  preloadImage?: string;
}

const {
  title,
  description,
  ogImage = '/images/ritz-carlton-resort-aerial-beach-pool.jpg',
  ogType = 'website',
  canonical,
  noindex = false,
  publishDate,
  updatedDate,
  schema,
  preloadImage,
} = Astro.props;

const siteUrl = 'https://destinationgotravel.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const fullTitle = title.includes('DestinationGo') ? title : `${title} | DestinationGo Travel`;

const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'DestinationGo Travel',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/images/dgota-logo.png`,
      },
      telephone: '864-506-0213',
      email: 'dawn@destinationgotravel.com',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '864-506-0213',
        contactType: 'customer service',
        areaServed: 'US',
        availableLanguage: 'English',
      },
      sameAs: [
        'https://facebook.com/profile.php?id=100095178252273',
        'https://instagram.com/destinationgotravelagency',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'DestinationGo Travel',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="DestinationGo Travel" />
{publishDate && <meta property="article:published_time" content={publishDate} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Hero image preload (eliminates LCP discovery delay for CSS background images) -->
{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

<!-- Fonts (non-render-blocking with print swap pattern) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lato:wght@400;700;900&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lato:wght@400;700;900&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lato:wght@400;700;900&display=swap" /></noscript>

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#062b30" />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
