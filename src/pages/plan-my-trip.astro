---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';

const contactPageSchema = {
  '@type': 'ContactPage',
  '@id': 'https://destinationgotravel.com/plan-my-trip#contact',
  name: 'Plan My Trip — DestinationGo Travel',
  description: 'Submit a trip inquiry to Dawn Owens, luxury travel advisor. Dawn will respond within one business day.',
  url: 'https://destinationgotravel.com/plan-my-trip',
  mainEntity: { '@id': 'https://destinationgotravel.com/#organization' },
};

---

<BaseLayout
  title="Plan My Trip — Start Planning Your Next Luxury Trip | DestinationGo Travel"
  description="Ready to travel? Tell Dawn where you want to go. She'll handle the research, planning, and logistics so you can focus on looking forward to the trip."
  schema={contactPageSchema}
>

  <PageHero
    eyebrow="Let's Get Started"
    heading="Tell Dawn where you want to go."
    subheading="Fill out the form below and Dawn will reach out within one business day to start building your trip."
    size="compact"
  />

  <!-- Main Content: Form + Sidebar -->
  <section class="plan-body">
    <div class="container">
      <div class="plan-grid">

        <!-- Inquiry Form (TravelJoy embed) -->
        <div class="plan-form-col">
          <div class="form-card">
            <div class="form-card-header">
              <p class="eyebrow eyebrow--teal">Trip Inquiry</p>
              <div class="hairline hairline--left"></div>
              <h2 class="form-card-heading">Tell Dawn about your trip.</h2>
              <p class="form-card-intro">No commitment required. Dawn reviews every inquiry personally and will reach out within one business day.</p>
            </div>
            <div class="form-embed">
              <script is:inline src="https://www.google.com/recaptcha/api.js?render=site-key"></script>
              <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/iframe-resizer/4.3.6/iframeResizer.min.js"></script>
              <iframe src="https://traveljoy.com/webforms/WcFEnCJZhi94VQxqZ7f482rt/forms/8yQmLFUX92Ta1KsoebJJge5S" frameborder="0" width="100%" height="600" id="tj-form-8yQmLFUX92Ta1KsoebJJge5S" title="Trip Inquiry Form"></iframe>
              <script is:inline>iFrameResize({checkOrigin:false, onInit: function() { document.getElementById("tj-form-8yQmLFUX92Ta1KsoebJJge5S").iFrameResizer.sendMessage({ origin: document.location.origin }); }});</script>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="plan-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-heading">What happens next</h3>
            <ol class="sidebar-steps">
              <li class="sidebar-step">
                <span class="step-num">1</span>
                <div>
                  <strong>Dawn reviews your inquiry</strong>
                  <p>She reads every submission personally and starts thinking about what would be right for you.</p>
                </div>
              </li>
              <li class="sidebar-step">
                <span class="step-num">2</span>
                <div>
                  <strong>She reaches out to connect</strong>
                  <p>Usually by email within one business day, sometimes sooner. She may suggest a short call to learn more.</p>
                </div>
              </li>
              <li class="sidebar-step">
                <span class="step-num">3</span>
                <div>
                  <strong>She gets to work</strong>
                  <p>Once you're aligned on the direction, Dawn handles the research, booking, and logistics from start to finish.</p>
                </div>
              </li>
            </ol>
          </div>

          <div class="sidebar-cost">
            <p class="cost-label">Your trip, fully handled.</p>
            <p class="cost-body">Dawn manages the research, planning, bookings, and all the logistics in between, so you can focus on looking forward to the trip, not managing it.</p>
          </div>

          <div class="sidebar-calendly">
            <p class="calendly-label">Prefer to talk first?</p>
            <p class="calendly-body">Skip the form and book a free 30-minute call with Dawn directly.</p>
            <a href="https://calendly.com/destinationgo/trip-planning-initial-discussion-1" target="_blank" rel="noopener noreferrer" class="btn btn--primary-teal calendly-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Book a Call with Dawn
            </a>
          </div>

          <div class="sidebar-contact">
            <p class="contact-label">Prefer to reach out directly?</p>
            <a href="tel:8645060213" class="contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.82 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              864-506-0213
            </a>
            <a href="mailto:dawn@destinationgotravel.com" class="contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              dawn@destinationgotravel.com
            </a>
          </div>

          <!-- Greece waitlist teaser -->
          <div class="sidebar-greece">
            <p class="sidebar-eyebrow">Coming Soon</p>
            <p class="sidebar-greece-heading">Interested in Greece?</p>
            <p class="sidebar-greece-body">Dawn is launching an exclusive all-women's escorted group trip to Greece. Limited spots available.</p>
            <a href="/destinations/greece" class="btn btn--outline-teal btn--sm">Learn More</a>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- Greece CTA -->
  <section class="greece-cta" id="greece-waitlist">
    <div class="container">
      <div class="greece-cta-inner">
        <p class="eyebrow eyebrow--gold">Exclusive Access</p>
        <div class="hairline" style="margin-inline:auto;"></div>
        <h2 class="greece-cta-heading">Planning a trip to Greece?</h2>
        <p class="greece-cta-body">Dawn is launching an exclusive all-women's escorted group trip to Greece. Limited spots available. Be the first to know when details are released.</p>
        <ul class="greece-perks">
          <li><svg class="perk-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Priority access before public announcement</li>
          <li><svg class="perk-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>No commitment required to join the list</li>
          <li><svg class="perk-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Directly from Dawn, no spam, no pressure</li>
        </ul>
        <a href="/destinations/greece" class="btn btn--outline-gold">Learn More About the Greece Trip</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>

  /* Body */
  .plan-body {
    padding: 4rem 0 5rem;
    background: #fff;
  }
  .plan-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
    max-width: 1100px;
    margin-inline: auto;
  }

  /* Form card */
  .form-card {
    background: var(--cream-50);
    border: 1px solid var(--gold-400);
    border-radius: 4px;
    overflow: hidden;
  }
  .form-card-header {
    padding: 2.5rem 2.5rem 0;
  }
  .form-card-heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.5vw + 0.75rem, 1.875rem);
    font-weight: 600;
    color: var(--ink-900);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }
  .form-card-intro {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-600);
    line-height: 1.65;
    margin-bottom: 0;
  }
  .form-embed {
    padding: 1.5rem 2.5rem 2.5rem;
  }
  .form-embed iframe {
    display: block;
    border: none;
    border-radius: 2px;
  }

  /* Sidebar */
  .plan-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
  .sidebar-card {
    background: var(--cream-50);
    border: 1px solid var(--gold-400);
    border-radius: 4px;
    padding: 2rem;
  }
  .sidebar-heading {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 1.5rem;
  }
  .sidebar-steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .sidebar-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    width: 2rem;
    height: 2rem;
    background: var(--teal-700);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .sidebar-step strong {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--ink-900);
    display: block;
    margin-bottom: 0.25rem;
  }
  .sidebar-step p {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-600);
    line-height: 1.6;
    margin: 0;
  }
  .sidebar-cost {
    background: var(--teal-700);
    border-radius: 4px;
    padding: 1.5rem;
  }
  .cost-label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--gold-400);
    margin-bottom: 0.5rem;
  }
  .cost-body {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(253,249,240,0.8);
    margin: 0;
  }
  .sidebar-calendly {
    background: var(--teal-800);
    border-radius: 4px;
    padding: 1.5rem;
  }
  .calendly-label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold-400);
    margin-bottom: 0.4rem;
  }
  .calendly-body {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(251,250,245,0.75);
    margin-bottom: 1.25rem;
  }
  .calendly-btn {
    width: 100%;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .sidebar-contact {
    background: var(--cream-50);
    border: 1px solid var(--gold-400);
    border-radius: 4px;
    padding: 1.5rem;
  }
  .contact-label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--teal-700);
    text-decoration: none;
    margin-bottom: 0.625rem;
    transition: color 150ms;
  }
  .contact-item:hover { color: var(--teal-500); }
  .sidebar-greece {
    background: var(--cream-50);
    border: 1px solid var(--gold-400);
    border-radius: 4px;
    padding: 1.5rem;
  }
  .sidebar-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gold-500);
    margin-bottom: 0.5rem;
  }
  .sidebar-greece-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 0.5rem;
  }
  .sidebar-greece-body {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-600);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .btn--sm { padding: 0.5rem 1.25rem; font-size: 0.8125rem; }

  /* Greece CTA */
  .greece-cta {
    background: var(--teal-700);
    padding: 5rem 0;
  }
  .greece-cta-inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }
  .greece-cta-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw + 0.5rem, 2.75rem);
    font-weight: 600;
    color: var(--cream-100);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .greece-cta-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(253,249,240,0.8);
    margin-bottom: 1.75rem;
  }
  .greece-perks {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }
  .greece-perks li {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: rgba(253,249,240,0.85);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .perk-check {
    color: var(--gold-400);
    flex-shrink: 0;
  }

  @media (max-width: 1000px) {
    .plan-grid { grid-template-columns: 1fr; }
    .plan-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }
  @media (max-width: 700px) {
    .plan-sidebar { grid-template-columns: 1fr; }
  }
</style>


