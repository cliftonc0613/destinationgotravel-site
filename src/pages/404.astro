---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | DestinationGo Travel"
  description="The page you were looking for doesn't exist. Return to DestinationGo Travel."
  noindex={true}
>
  <section class="not-found">
    <div class="container">
      <div class="not-found-inner">
        <div class="not-found-number" aria-hidden="true">404</div>
        <h1 class="not-found-heading">This page seems to have wandered off.</h1>
        <p class="not-found-body">Maybe it booked a trip without telling us. Either way, it's not here — but we can help you get where you're going.</p>
        <div class="not-found-ctas">
          <a href="/" class="btn btn--teal">Go Home</a>
          <a href="/plan-my-trip" class="btn btn--ghost">Plan My Trip</a>
        </div>
        <div class="not-found-links">
          <a href="/about">About Dawn</a>
          <span aria-hidden="true">·</span>
          <a href="/destinations">Destinations</a>
          <span aria-hidden="true">·</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">·</span>
          <a href="mailto:dawn@destinationgotravel.com">Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background-color: var(--cream-50);
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding: 5rem 0;
  }
  .not-found-inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }
  .not-found-number {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 700;
    color: var(--teal-700);
    opacity: 0.12;
    line-height: 1;
    margin-bottom: -1rem;
  }
  .not-found-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw + 0.75rem, 2.25rem);
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .not-found-body {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: var(--ink-600);
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }
  .not-found-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .not-found-links {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  .not-found-links a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--teal-600, #1a6b6b);
    text-decoration: none;
    transition: color 150ms;
  }
  .not-found-links a:hover { color: var(--teal-700); text-decoration: underline; }
  .not-found-links span { color: var(--ink-400); }
</style>
