---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';

// Draft posts excluded from build
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Sort newest first
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categories = ['All', 'Europe', 'All-Inclusive', 'Cruises', 'General'];

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

const schema = {
  '@type': 'CollectionPage',
  '@id': 'https://destinationgotravel.com/blog#page',
  name: 'Travel Blog — DestinationGo Travel',
  description: 'Travel tips, destination guides, and planning advice for empty nesters and retirees from luxury travel advisor Dawn Owens.',
  url: 'https://destinationgotravel.com/blog',
  publisher: { '@id': 'https://destinationgotravel.com/#organization' },
};
---

<BaseLayout
  title="Travel Tips & Inspiration — DestinationGo Travel Blog"
  description="Travel advice for empty nesters from Dawn Owens. Europe itineraries, resort picks, and cruise guides from a luxury travel advisor in Greenville, SC."
  schema={schema}
>

  <PageHero
    eyebrow="The Blog"
    heading="Travel inspiration, honestly told."
    subheading="Real advice from an advisor who's actually been there: Europe itineraries, resort picks, cruise guides, and more."
  />

  <!-- Filter Tabs -->
  <div class="blog-filter-bar">
    <div class="container">
      <div class="filter-tabs" role="tablist" aria-label="Filter posts by category">
        {categories.map((cat) => (
          <button
            class={`filter-tab${cat === 'All' ? ' filter-tab--active' : ''}`}
            data-category={cat}
            role="tab"
            aria-selected={cat === 'All' ? 'true' : 'false'}
            id={`tab-${cat.toLowerCase().replace(/\s+/g, '-')}`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Post Grid -->
  <section class="blog-grid-section">
    <div class="container">
      {posts.length === 0 ? (
        <div class="blog-empty">
          <p class="eyebrow" style="text-align:center;">Coming Soon</p>
          <div class="hairline" style="margin-inline:auto;margin-bottom:2rem;"></div>
          <h2 class="blog-empty-heading">Travel stories on the way.</h2>
          <p class="blog-empty-body">Dawn is writing up her best advice on Europe, all-inclusive resorts, and cruises. Check back soon, or <a href="/plan-my-trip" class="cta-link">start planning your trip now</a>.</p>
        </div>
      ) : (
        <div class="blog-grid" id="blog-grid">
          {posts.map((post) => (
            <article
              class={`blog-card card card-hover${post.data.featured ? ' blog-card--featured' : ''}`}
              data-category={post.data.category}
            >
              <a href={`/blog/${post.id}`} class="blog-card-link" tabindex="-1" aria-hidden="true">
                <div class="blog-card-image">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt}
                    width="800"
                    height="450"
                    loading="lazy"
                  />
                  <span class="blog-card-category">{post.data.category}</span>
                </div>
              </a>
              <div class="blog-card-body">
                <p class="blog-card-date">{formatDate(post.data.publishDate)}</p>
                <h2 class="blog-card-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="blog-card-desc">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="cta-link">Read More →</a>
              </div>
            </article>
          ))}
        </div>
      )}

      <!-- No results message (shown via JS) -->
      <p class="blog-no-results" id="blog-no-results" hidden>
        No posts in this category yet. <a href="/plan-my-trip" class="cta-link">Ready to start planning?</a>
      </p>
    </div>
  </section>

  <FinalCTA />

</BaseLayout>

<style>
  /* Filter bar */
  .blog-filter-bar {
    background: #fff;
    border-bottom: 1px solid var(--line);
    padding: 0;
    position: sticky;
    top: 72px; /* below fixed header */
    z-index: 10;
  }
  .filter-tabs {
    display: flex;
    gap: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .filter-tabs::-webkit-scrollbar { display: none; }
  .filter-tab {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-500);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .filter-tab:hover { color: var(--teal-700); }
  .filter-tab--active {
    color: var(--teal-700);
    border-bottom-color: var(--teal-700);
  }

  /* Grid */
  .blog-grid-section {
    padding: 4rem 0 6rem;
    background: var(--cream-50);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .blog-card--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .blog-card--featured .blog-card-image {
    flex: 0 0 55%;
    max-height: 400px;
  }
  .blog-card--featured .blog-card-image img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .blog-card--featured .blog-card-body {
    flex: 1;
    justify-content: center;
    padding: 3rem;
  }
  .blog-card-link { display: block; }
  .blog-card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }
  .blog-card:not(.blog-card--featured) .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-resort);
  }
  .blog-card:not(.blog-card--featured):hover .blog-card-image img {
    transform: scale(1.04);
  }
  .blog-card-category {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--teal-700);
    background: rgba(253, 249, 240, 0.92);
    padding: 4px 10px;
    border-radius: 3px;
  }
  .blog-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    flex: 1;
  }
  .blog-card-date {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-300);
  }
  .blog-card-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.5vw + 0.5rem, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-900);
  }
  .blog-card-title a {
    text-decoration: none;
    color: inherit;
    transition: color 150ms ease;
  }
  .blog-card-title a:hover { color: var(--teal-700); }
  .blog-card-desc {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-600, var(--ink-700));
    flex: 1;
  }

  /* Empty / no-results */
  .blog-empty {
    text-align: center;
    padding: 4rem 0;
    max-width: 560px;
    margin-inline: auto;
  }
  .blog-empty-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw + 0.5rem, 2.25rem);
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 1rem;
  }
  .blog-empty-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-700);
  }
  .blog-no-results {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--ink-700);
    padding: 3rem 0;
  }
  .blog-no-results[hidden] { display: none; }

  /* Card hidden during filter */
  .blog-card[data-hidden] { display: none !important; }

  @media (max-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
    .blog-card--featured { flex-direction: column; }
    .blog-card--featured .blog-card-image { flex: none; aspect-ratio: 16/9; max-height: none; }
    .blog-card--featured .blog-card-body { padding: 1.75rem; }
  }
  @media (max-width: 640px) {
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  const noResults = document.getElementById('blog-no-results');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const category = tab.dataset.category ?? 'All';

      // Update tab states
      tabs.forEach((t) => {
        t.classList.remove('filter-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('filter-tab--active');
      tab.setAttribute('aria-selected', 'true');

      // Filter cards
      let visible = 0;
      cards.forEach((card) => {
        const match = category === 'All' || card.dataset.category === category;
        if (match) {
          card.removeAttribute('data-hidden');
          visible++;
        } else {
          card.setAttribute('data-hidden', '');
        }
      });

      if (noResults) {
        noResults.hidden = visible > 0;
      }
    });
  });
</script>
