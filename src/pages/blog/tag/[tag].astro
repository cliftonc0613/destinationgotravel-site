---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import FinalCTA from '../../../components/sections/FinalCTA.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.tags.map((t) => t.toLowerCase().replace(/\s+/g, '-')).includes(Astro.params.tag));
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title={`#${tag} — DestinationGo Travel Blog`}
  description={`Browse all posts tagged "${tag}" from Dawn Owens, luxury travel advisor for empty nesters and retirees.`}
>

  <PageHero
    eyebrow="Blog"
    heading={`Tagged: ${tag}`}
    subheading={`All posts tagged with "${tag}".`}
    size="compact"
  />

  <section class="blog-grid-section">
    <div class="container">
      <p class="back-link"><a href="/blog" class="cta-link">Back to all posts</a></p>
      {posts.length === 0 ? (
        <div class="blog-empty">
          <h2 class="blog-empty-heading">No posts with this tag yet.</h2>
          <p class="blog-empty-body">Check back soon, or <a href="/plan-my-trip" class="cta-link">start planning your trip now</a>.</p>
        </div>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => (
            <article class={`blog-card card card-hover${post.data.featured ? ' blog-card--featured' : ''}`}>
              <a href={`/blog/${post.id}`} class="blog-card-link" tabindex="-1" aria-hidden="true">
                <div class="blog-card-image">
                  <img src={post.data.heroImage} alt={post.data.heroImageAlt} width="800" height="450" loading="lazy" />
                  <span class="blog-card-category">{post.data.category}</span>
                </div>
              </a>
              <div class="blog-card-body">
                <p class="blog-card-date">{formatDate(post.data.publishDate)}</p>
                <h2 class="blog-card-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                <p class="blog-card-desc">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="cta-link">Read More</a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <FinalCTA />

</BaseLayout>

<style>
  .back-link { margin-bottom: 2rem; font-family: var(--font-sans); font-size: 0.875rem; }
  .blog-grid-section { padding: 4rem 0 6rem; background: var(--cream-50); }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .blog-card { display: flex; flex-direction: column; overflow: hidden; }
  .blog-card--featured { grid-column: 1 / -1; flex-direction: row; }
  .blog-card--featured .blog-card-image { flex: 0 0 55%; max-height: 400px; }
  .blog-card--featured .blog-card-image img { height: 100%; width: 100%; object-fit: cover; }
  .blog-card--featured .blog-card-body { flex: 1; justify-content: center; padding: 3rem; }
  .blog-card-link { display: block; }
  .blog-card-image { position: relative; overflow: hidden; aspect-ratio: 16/9; }
  .blog-card:not(.blog-card--featured) .blog-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease-resort); }
  .blog-card:not(.blog-card--featured):hover .blog-card-image img { transform: scale(1.04); }
  .blog-card-category { position: absolute; top: 1rem; left: 1rem; font-family: var(--font-sans); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--teal-700); background: rgba(253,249,240,0.92); padding: 4px 10px; border-radius: 3px; }
  .blog-card-body { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.75rem; flex: 1; }
  .blog-card-date { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-300); }
  .blog-card-title { font-family: var(--font-display); font-size: clamp(1.125rem, 1.5vw + 0.5rem, 1.5rem); font-weight: 600; line-height: 1.3; color: var(--ink-900); }
  .blog-card-title a { text-decoration: none; color: inherit; transition: color 150ms ease; }
  .blog-card-title a:hover { color: var(--teal-700); }
  .blog-card-desc { font-family: var(--font-sans); font-size: 0.9375rem; line-height: 1.75; color: var(--ink-600); flex: 1; }
  .blog-empty { text-align: center; padding: 4rem 0; max-width: 560px; margin-inline: auto; }
  .blog-empty-heading { font-family: var(--font-display); font-size: clamp(1.5rem, 2vw + 0.5rem, 2.25rem); font-weight: 600; color: var(--ink-900); margin-bottom: 1rem; }
  .blog-empty-body { font-family: var(--font-sans); font-size: 1rem; line-height: 1.75; color: var(--ink-700); }
  @media (max-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
    .blog-card--featured { flex-direction: column; }
    .blog-card--featured .blog-card-image { flex: none; aspect-ratio: 16/9; max-height: none; }
    .blog-card--featured .blog-card-body { padding: 1.75rem; }
  }
  @media (max-width: 640px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
