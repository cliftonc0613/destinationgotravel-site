---
import BaseLayout from '../components/layout/BaseLayout.astro';
const lastUpdated = 'May 2026';

const schema = {
  '@type': 'WebPage',
  '@id': 'https://destinationgotravel.com/privacy-policy#page',
  name: 'Privacy Policy — DestinationGo Travel',
  url: 'https://destinationgotravel.com/privacy-policy',
  publisher: { '@id': 'https://destinationgotravel.com/#organization' },
};
---

<BaseLayout
  title="Privacy Policy | DestinationGo Travel"
  description="Privacy policy for DestinationGo Travel. How we collect, use, and protect your information."
  noindex={true}
  schema={schema}
>
  <section class="legal-page">
    <div class="container">
      <div class="legal-inner">
        <p class="eyebrow">Legal</p>
        <div class="hairline hairline--left"></div>
        <h1 class="legal-heading">Privacy Policy</h1>
        <p class="legal-date">Last updated: {lastUpdated}</p>

        <div class="legal-body prose">
          <h2>1. Information We Collect</h2>
          <p>When you submit a form on this website (such as a trip inquiry or the Greece waitlist), we collect the information you provide, which may include your name, email address, phone number, and details about your travel interests.</p>
          <p>We also collect standard website analytics data (such as page views and traffic sources) to improve our site. This data is anonymized and does not identify you personally.</p>

          <h2>2. How We Use Your Information</h2>
          <p>We use the information you provide solely to respond to your inquiries, assist with travel planning, and (if you opt in) send occasional travel inspiration emails. We do not sell, rent, or share your personal information with third parties for marketing purposes.</p>

          <h2>3. Email Communications</h2>
          <p>If you subscribe to our email list, you may unsubscribe at any time using the unsubscribe link in any email we send. We will not send you unsolicited communications.</p>

          <h2>4. Data Security</h2>
          <p>We take reasonable steps to protect the information you share with us. Form submissions are processed through Netlify, which maintains its own security practices. We do not store credit card or payment information on this website.</p>

          <h2>5. Cookies</h2>
          <p>This website may use cookies for basic analytics functionality. You can disable cookies in your browser settings, though this may affect some features of the site.</p>

          <h2>6. Third-Party Services</h2>
          <p>This site uses Google Fonts for typography and may use third-party analytics tools. These services have their own privacy policies, which we encourage you to review.</p>

          <h2>7. Contact</h2>
          <p>If you have questions about this privacy policy or how we handle your information, please contact us at <a href="mailto:dawn@destinationgotravel.com">dawn@destinationgotravel.com</a>.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    background: var(--cream-50);
    padding: 5rem 0;
  }
  .legal-inner {
    max-width: 760px;
    margin-inline: auto;
  }
  .legal-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.5rem);
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 0.25rem;
  }
  .legal-date {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-500);
    margin-bottom: 3rem;
  }
</style>
