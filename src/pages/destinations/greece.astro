const BOOK_URL = 'https://traveljoy.com/bookings/hp6ZEtYGxAML6wSzKgzrU3E5?fbclid=IwY2xjawSem7NleHRuA2FlbQIxMABicmlkETFteE9ORldoNjdCUnJmamJTc3J0YwZhcHBfaWQQMjIyMDM5MTc4ODIwMDg5MgABHr07Ja3jENe7riKrEadZzoJKoU3Dx9HkH0QE5-fjPIICDxuhjIJ7Oo-Ag4Na_aem_q-2I84k0ZGGpNgQ4EHOLOw';

const pageSchema = {
