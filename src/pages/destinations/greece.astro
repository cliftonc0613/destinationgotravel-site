    subtitle: 'Single Occupancy',
    price: '$12,200',
    perPerson: true,
    badge: 'Best Value Solo',
    santorini: 'Secret View Hotel — Sunset Sea View Room',
    paros: 'Vione Paros — Junior Suite with Private Pool',
    bedding: 'Your own private room at both properties.',
