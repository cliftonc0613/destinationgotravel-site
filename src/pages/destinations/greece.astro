    deposit: '$1,000',
    payments: [
      { amount: '$1,875', due: 'Due August 7, 2026' },
      { amount: '$1,875', due: 'Due November 7, 2026' },
      { amount: '$1,875', due: 'Due February 7, 2027' },
      { amount: '$1,875', due: 'Due June 7, 2027' },
    ],
  },
  {
