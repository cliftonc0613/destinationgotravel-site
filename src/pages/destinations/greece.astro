    price: '$9,000',
    perPerson: true,
    badge: 'Most Popular',
    santorini: 'Secret View Hotel — Sunset Sea View Room',
    paros: 'Vione Paros — Junior Suite with Private Pool',
    bedding: 'Santorini: Queen Bed. Paros: Twin beds.',
    deposit: '$1,000',
    payments: [
      { amount: '$2,000', due: 'Due August 7, 2026' },
      { amount: '$2,000', due: 'Due November 7, 2026' },
      { amount: '$2,000', due: 'Due February 7, 2027' },
      { amount: '$2,000', due: 'Due June 7, 2027' },
    ],
  },
  {
