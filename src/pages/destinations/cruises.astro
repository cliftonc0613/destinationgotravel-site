---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import SocialProof from '../../components/sections/SocialProof.astro';

const serviceSchema = {
  '@type': 'Service',
  '@id': 'https://destinationgotravel.com/destinations/cruises#service',
  name: 'Cruise Planning',
  description: 'Expert cruise planning for empty nesters and retirees — river cruises, ocean voyages, and small-ship expeditions matched to the way you actually travel.',
  provider: { '@id': 'https://destinationgotravel.com/#organization' },
  areaServed: { '@type': 'Country', name: 'United States' },
  serviceType: 'Travel Planning',
  url: 'https://destinationgotravel.com/destinations/cruises',
};

const cruiseTypes = [
  {
    type: 'River Cruises',
    description: 'The Rhine, Danube, Douro, Seine. River cruising is slow travel at its best — waking up in a new village every morning, no sea days. Dawn knows which lines and itineraries are worth the investment.',
    ideal: 'Ideal for: Europe lovers, couples, those who prefer intimacy over scale',
  },
  {
    type: 'Ocean Cruises',
    description: 'From the Caribbean to Alaska, the Mediterranean to Scandinavia. Dawn matches you to the right cruise line for your style — whether that\'s understated luxury or a mid-size ship that balances amenities with intimacy.',
    ideal: 'Ideal for: First-time cruisers, longer voyages, bucket-list destinations',
  },
  {
    type: 'Small-Ship Expeditions',
    description: 'Glaciers, fjords, and coastlines that big ships can\'t reach. Expedition cruising is for travelers who want something more immersive — and Dawn knows the operators who deliver it with genuine expertise.',
    ideal: 'Ideal for: Nature-focused travelers, Alaska, Galápagos, Antarctica',
  },
];

const cabinTips = [
  'Cabin location affects comfort more than category',
  'The right deck matters for motion sensitivity',
  'Balcony vs. ocean view depends on your itinerary',
  'Dawn handles cabin selection — so you get the right one',
];
---

<BaseLayout
  title="Cruise Planning — River, Ocean & Expedition Cruises | DestinationGo Travel"
  description="Cruise planning for empty nesters and retirees in Greenville, SC. River cruises, ocean voyages, and small-ship expeditions — matched to how you actually travel."
  schema={serviceSchema}
>

  <PageHero
    eyebrow="Cruises"
    heading="The right ship. The right cabin. No surprises when you board."
    subheading="Dawn matches you to the cruise that fits your pace and preferences — so you board with confidence, not hope."
    ctaText="Plan a Cruise"
    ctaHref="/plan-my-trip"
  />

  <!-- Cruise Types -->
  <section class="cruise-types">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Types of Cruises</p>
      <div class="hairline" style="margin-inline:auto;margin-bottom:1rem;"></div>
      <h2 class="cruise-types-heading">Three ways to experience the water</h2>
      <div class="cruise-types-grid">
        {cruiseTypes.map(ct => (
          <div class="cruise-type-card card card-hover">
            <h3 class="cruise-type-name">{ct.type}</h3>
            <p class="cruise-type-body">{ct.description}</p>
            <p class="cruise-type-ideal">{ct.ideal}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cabin advice -->
  <section class="cabin-section">
    <div class="container">
      <div class="cabin-grid">
        <div>
          <p class="eyebrow">The Details Matter</p>
          <div class="hairline hairline--left"></div>
          <h2 class="cabin-heading">Cabin selection is more complex than it looks.</h2>
          <p class="cabin-body">Most people book a cabin category without thinking about location, deck, proximity to elevators, or how the ship's layout will affect their experience. Dawn thinks about all of it — because that's the difference between a good cruise and a great one.</p>
          <ul class="cabin-tips">
            {cabinTips.map(tip => (
              <li class="cabin-tip">
                <svg class="cabin-tip-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {tip}
              </li>
            ))}
          </ul>
        </div>
        <div class="cabin-cta-box">
          <p class="cabin-cta-label">Ready to find your cruise?</p>
          <p class="cabin-cta-body">Tell Dawn where you want to go and how you like to travel. She'll take it from there.</p>
          <a href="/plan-my-trip" class="btn btn--teal">Plan My Cruise</a>
        </div>
      </div>
    </div>
  </section>

  <SocialProof />
  <FinalCTA />

</BaseLayout>

<style>
  /* Types */
  .cruise-types {
    padding: 5rem 0;
    background: var(--cream-50);
  }
  .cruise-types-heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw + 0.5rem, 2rem);
    font-weight: 600;
    color: var(--ink-900);
    text-align: center;
    margin-bottom: 3rem;
  }
  .cruise-types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin-inline: auto;
  }
  .cruise-type-card { padding: 2rem; }
  .cruise-type-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--teal-700);
    margin-bottom: 0.75rem;
  }
  .cruise-type-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-600);
    margin-bottom: 1rem;
  }
  .cruise-type-ideal {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--teal-500);
    border-top: 1px solid var(--gold-300, #d4b86a);
    padding-top: 0.75rem;
  }

  /* Cabin section */
  .cabin-section {
    padding: 5rem 0;
    background: #fff;
  }
  .cabin-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    max-width: 1100px;
    margin-inline: auto;
  }
  .cabin-heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.5vw + 0.75rem, 2rem);
    font-weight: 600;
    color: var(--ink-900);
    line-height: 1.3;
    margin-bottom: 1.25rem;
  }
  .cabin-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-600);
    margin-bottom: 1.75rem;
  }
  .cabin-tips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cabin-tip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-700);
  }
  .cabin-tip-check {
    color: var(--teal-600, #1a6b6b);
    font-weight: 700;
    flex-shrink: 0;
  }
  .cabin-cta-box {
    background-color: var(--cream-50);
    border: 1px solid var(--gold-400);
    border-radius: 4px;
    padding: 3rem 2.5rem;
    text-align: center;
  }
  .cabin-cta-label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink-900);
    margin-bottom: 1rem;
  }
  .cabin-cta-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-600);
    margin-bottom: 2rem;
  }

  @media (max-width: 900px) {
    .cruise-types-grid { grid-template-columns: 1fr; }
    .cabin-grid { grid-template-columns: 1fr; }
  }
</style>
